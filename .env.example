# Copy this file to .env.local and fill in your values.
# .env.local is gitignored — secrets never leave your machine/server.

# ── AI engine ────────────────────────────────────────────────
# Get one at https://platform.openai.com/api-keys
# Without a key, JARVIS runs in Demo Mode (canned replies).
OPENAI_API_KEY=

# Model to use (gpt-4o-mini is fast + cheap; gpt-4o is smarter)
OPENAI_MODEL=gpt-4o-mini

# ── Phase 2: live web research ───────────────────────────────
# Tavily is what Perplexity-style search uses. Add later.
TAVILY_API_KEY=

# ── Phase 3: database + auth (Supabase) ──────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
